// HydraSkript - AI Book Generation Platform
// Prisma Schema (PostgreSQL)
// Prisma 7+ - URL will be provided via prisma.config.ts

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // URL moved to prisma.config.ts
}

model Profile {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                 String    @unique
  name                  String    @default("Anonymous Author")
  credits               Int       @default(0) // Legacy single wallet (kept for backward compatibility)
  monthlyCredits        Int       @default(0) // Monthly credits (Founder/paid plans) - do not roll over
  purchasedCredits      Int       @default(0) // A-la-carte purchased credits - never expire
  lifetimeCredits       Int       @default(0) // Promotional/founder lifetime credits
  tier                  String    @default("free") // free, starter, author, publisher, studio, founder
  isLifetime            Boolean   @default(false)
  founderNumber         Int?      @unique
  founderBadge          Boolean   @default(false)
  monthlyCreditAllowance Int      @default(0)
  monthlyCreditsLastGrantedAt DateTime?
  audiobookEnabled      Boolean   @default(false)
  isAdmin               Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Stripe fields
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  subscriptionStatus    String    @default("inactive")
  currentPeriodEnd      DateTime?
  freeCreditsGranted    Boolean   @default(false)

  // Relations
  books                 Book[]
  styleProfiles         StyleProfile[]
  mediaAssets           MediaAsset[]
  jobs                  Job[]
  creditLedger          CreditLedger[]
  payments              Payment[]
  storyBible            StoryBibleEntity[]
  editorialReviews      EditorialReview[]
  founderSale           FounderSale?
  bookListings          BookListing[]

  @@map("profiles")
}

model StyleProfile {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId       String   @db.Uuid
  name          String
  description   String   @default("")
  exemplarTexts String   @default("[]") // JSON array of text samples
  embedding     String   @default("[]") // JSON array of 768 floats (average embedding)
  systemPrompt  String   @default("") // Generated "Write like this" instruction
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  owner Profile @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  books Book[]

  @@map("style_profiles")
}

model Book {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId               String   @db.Uuid
  title                 String
  description           String?  // User's description of what the book should be about
  genre                 String   @default("fiction")
  targetAudience        String   @default("adult") // adult, 0-5, 6-9, 10-14
  maxPages              Int      @default(600) // Computed from targetAudience in app logic
  styleProfileId        String?  @db.Uuid
  status                String   @default("draft") // draft, outlining, awaiting_outline_approval, writing, awaiting_chapter_approval, finalizing, completed, failed
  totalCreditsEstimated Int      @default(0)
  totalCreditsCharged   Int      @default(0)
  visualIdentityUrl     String? // URL to the approved character reference sheet
  characterSheet        String? // JSON: canonical character appearances [{name, countNoun, isAnimal, descriptor}] — extracted once, copied verbatim into every illustration prompt and the cover so the cast looks identical on every page
  coloringTheme         String? // For coloring books: mandalas, undersea-creatures, birds, etc.
  adventureType         String? // For kids books: farm, school, fair, boat, forest, beach, space, zoo, castle, city
  chapterCount          Int?     // Number of chapters for this book
  characterNames        String[] @default([]) // Postgres native array: [mainCharacter, ...friendNames] up to 5 names
  outline               String   @default("{}") // JSON: { title, chapters: [{title, synopsis, wordTarget}] }
  coverImageUrl         String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  owner            Profile            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  styleProfile     StyleProfile?      @relation(fields: [styleProfileId], references: [id], onDelete: SetNull)
  chapters         Chapter[]
  mediaAssets      MediaAsset[]
  jobs             Job[]
  storyBible       StoryBibleEntity[]
  editorialReviews EditorialReview[]

  @@index([ownerId])
  @@map("books")
}

model Chapter {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookId               String   @db.Uuid
  index                Int // 0-based
  title                String   @default("")
  synopsis             String   @default("") // From outline
  wordTarget           Int      @default(1500)
  content              String   @default("")
  wordCount            Int      @default(0) // Computed in app logic
  status               String   @default("pending") // pending, writing, reviewing, completed, failed
  approvalStatus       String   @default("pending") // pending, approved, rejected
  generationJobId      String?
  charactersIntroduced String   @default("[]") // JSON array
  summaryForNext       String   @default("") // Summary for continuity
  illustrationUrl      String? // Generated image URL
  illustrationPrompt   String   @default("") // The prompt used to generate the illustration
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // Relations
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, index])
  @@map("chapters")
}

// ─── Story Bible ──────────────────────────────────────────────────────────────
// Canonical lore store that the AI can read while writing. Each entity
// belongs to a single book. The `kind` enum determines which list/detail
// page the entity surfaces under (Characters / Locations / Objects /
// Themes / History). physicalTraits and secrets are stored as JSON
// strings so we can evolve the shape without further migrations.
model StoryBibleEntity {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId        String   @db.Uuid
  bookId         String   @db.Uuid
  kind           String // CHARACTER, LOCATION, OBJECT, THEME, HISTORY
  name           String
  role           String   @default("") // e.g. "Main Character", "Capital City"
  summary        String   @default("") // Short blurb shown under name
  motivation     String   @default("") // For CHARACTER: core drive
  description    String   @default("") // Long-form description (used by Themes/History primarily)
  physicalTraits String   @default("{}") // JSON: { tags: string[], notes: string }
  secrets        String   @default("{}") // JSON: { confidential: string, isPrivate: boolean }
  portraitUrl    String? // Optional portrait/cover image URL
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  owner Profile @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  book  Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId, kind])
  @@index([ownerId])
  @@map("story_bible_entities")
}

model MediaAsset {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId     String   @db.Uuid
  bookId      String?  @db.Uuid
  assetType   String // cover, illustration, coloring_page, audiobook_chapter, audiobook_complete, pdf_export
  storagePath String // Local file path or URL
  publicUrl   String // Accessible URL
  metadata    String   @default("{}") // JSON: {duration, dimensions, chapterIndex, etc}
  paymentSource String?  @default("subscription_allowance") // subscription_allowance, ala_carte_topup
  createdAt   DateTime @default(now())

  // Relations
  owner Profile @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  book  Book?   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@index([ownerId])
  @@index([assetType])
  @@map("media_assets")
}

// ─── Enums ─────────────────────────────────────────────────────────────────────

// ─── Enums ─────────────────────────────────────────────────────────────────────

enum JobType {
  write_chapter
  generate_image
  generate_audiobook
  export_pdf
  generate_outline
  finalize_book
  editorial_review
  import_manuscript
}

enum JobStatus {
  queued
  active
  completed
  failed
}

enum BookStatus {
  draft
  generating
  completed
  failed
  outlining
  awaiting_outline_approval
  writing
  awaiting_chapter_approval
  finalizing
}

enum ChapterStatus {
  pending
  writing
  reviewing
  awaiting_approval
  completed
  failed
}

enum EditorReviewStatus {
  queued
  active
  completed
  failed
}

model Job {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookId          String?   @db.Uuid
  ownerId         String    @db.Uuid
  jobType         JobType
  status          JobStatus    @default(queued)
  progressMessage String    @default("Queued...")
  progressPercent Int       @default(0)
  creditsReserved Int       @default(0) // Held in escrow
  creditsConsumed Int       @default(0)
  estimatedCostCents Int?   // Estimated cost before generation (before work begins)
  actualCostCents Int?      // Actual cost after generation completed
  provider               String?   // NVIDIA NIM, OpenRouter, Gemini, etc.
  modelName              String?   // The specific model used
  tokensIn               Int?      // Input tokens consumed
  tokensOut              Int?      // Output tokens generated
  errorMessage    String?
  stepIndex       Int       @default(0) // For idempotency: which step is this
  retryCount      Int       @default(0)
  maxRetries      Int       @default(3)
  leaseExpiresAt  DateTime?
  lastHeartbeatAt DateTime?
  result          String    @default("{}") // JSON result data
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())

  // Relations
  owner            Profile           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  book             Book?             @relation(fields: [bookId], references: [id], onDelete: Cascade)
  creditLedger     CreditLedger[]
  editorialReviews EditorialReview[]

  @@index([status, leaseExpiresAt])
  // The queue claim is `WHERE status = 'queued' AND (lease null or expired)
  // ORDER BY createdAt ASC LIMIT 1`. Without this index Postgres sorts the
  // whole queued set on every claim — i.e. every 5s poll and every pump kick —
  // which is CPU the pooled connection spends inside the query instead of
  // handing it to the next status update (P2028).
  @@index([status, createdAt])
  @@index([ownerId])
  @@index([bookId])
  @@map("jobs")
}

model CreditLedger {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId String   @db.Uuid
  amount    Int // negative for spend, positive for purchase/refund
  reason    String
  jobId     String?  @db.Uuid
  createdAt DateTime @default(now())

  // Relations
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  job     Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([profileId])
  @@index([jobId])
  @@map("credit_ledger")
}

model Payment {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId            String    @db.Uuid
  pricingKey           String
  provider             String    @default("stripe")
  mode                 String // subscription or payment
  status               String    @default("pending")
  stripeSessionId      String?   @unique
  stripeInvoiceId      String?   @unique
  stripeSubscriptionId String?
  stripeCustomerId     String?
  amountCents          Int
  currency             String    @default("usd")
  creditsGranted       Int       @default(0)
  tierApplied          String?
  fulfilledAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
  @@map("payments")
}

model FounderSale {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId               String    @db.Uuid @unique
  founderNumber           Int       @unique
  pricePaidCents          Int
  stripeCheckoutSessionId String    @unique
  stripePaymentIntentId   String?   @unique
  createdAt               DateTime  @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("founder_sales")
}

model EditorialReview {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId      String   @db.Uuid
  bookId       String?  @db.Uuid
  jobId        String?  @db.Uuid
  scope        String // 'book' | 'manuscript'
  sourceLabel  String
  status       String   @default("queued") // queued, active, completed, failed
  textLength   Int      @default(0)
  errorMessage String?
  sourceText   String?
  completedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  book     Book?             @relation(fields: [bookId], references: [id], onDelete: Cascade)
  owner    Profile           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  job      Job?              @relation(fields: [jobId], references: [id], onDelete: SetNull)
  findings EditorialFinding[]

  @@index([ownerId, createdAt])
  @@map("editorial_reviews")
}

model EditorialFinding {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reviewId    String   @db.Uuid
  severity    String
  category    String
  title       String
  description String
  quote       String   @default("")
  location    String   @default("")
  bookTitle   String   @default("")
  suggestion  String   @default("")
  status      String   @default("open")
  createdAt   DateTime @default(now())

  // Relations
  review EditorialReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("editorial_findings")
}

// ─── Bookstore Listings ───────────────────────────────────────────────────────
// Author-submitted books listed for sale in the Bookstore marketplace.

model BookListing {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId     String   @db.Uuid
  title       String
  author      String   @default("")
  description String   @default("")
  price       Float    @default(0) // USD
  format      String   @default("ebook") // ebook, audiobook, both
  fileName    String?  // Original uploaded filename
  fileUrl     String?  // Public URL of the uploaded file (stored under /assets/listings)
  coverUrl    String?  // Optional cover image URL
  status      String   @default("active") // active, draft, removed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  owner Profile @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([status])
  @@map("book_listings")
}
