{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npx prisma generate && next build",
  "devCommand": "next dev -p 3002",
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "crons": [
    {
      "path": "/api/queue/pump",
      "schedule": "0 0 * * *"
    }
  ]
}
